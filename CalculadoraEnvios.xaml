<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E130148.CalculadoraEnvios"
             Title="CalculadoraEnvios"
             BackgroundColor="White">
    
    <ScrollView>
   
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

       
            <Border BackgroundColor="Black" Stroke="Black" StrokeShape="RoundRectangle 8" Padding="10">
                <Label Text=" CALCULADORA DE ENVIOS " FontSize="22" FontAttributes="Bold" 
                       TextColor="White" HorizontalOptions="Center"/>
            </Border>

            <!-- Campo para agregar la descripción -->
            <Label Text="Descripción del paquete:" TextColor="Black" FontAttributes="Bold"/>

          
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0" BackgroundColor="White">
    
                <Entry x:Name="txtPeso" Placeholder="Documento o Paquete Ejemplo" TextColor="Black" PlaceholderColor="Gray"/>
            </Border>

            <!-- Campo Peso -->
            <Label Text="Peso del paquete (kg):" TextColor="Black" FontAttributes="Bold"/>

            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0" BackgroundColor="White">
                <Entry x:Name="txtAltura" Placeholder="Ejemplo: 2.5" Keyboard="Numeric" TextColor="Black" PlaceholderColor="Gray"/>
            </Border>

            <!-- Zona de destino -->
            <Label Text="Zona de destino" TextColor="Black" FontSize="14" FontAttributes="Bold"/>

            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0" BackgroundColor="White">
                <Picker x:Name="pckDestino" Title="Seleccione destino" TitleColor="Gray" TextColor="Black" BackgroundColor="White">
                    <Picker.Items>
                        <x:String>Zona Local</x:String>
                        <x:String>Zona Nacional</x:String>
                        <x:String>Zona Internacional</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <!-- Checkbox para servicio exprés -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <CheckBox x:Name="chkExpres" Color="Black"/>
                <Label Text="Servicio exprés (+ L 100.00)" TextColor="Black" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Botón para calcular -->
            <Button Text="CALCULAR ENVIOS" BackgroundColor="Black" TextColor="White"
                    FontAttributes="Bold" CornerRadius="48" Clicked="Button_Clicked"/>

            <!-- Tarjeta de resultados -->
            <Border x:Name="brResultado" Stroke="Black" StrokeShape="RoundRectangle 12" Padding="20" IsVisible="False" Margin="0,10,0,0" BackgroundColor="White">
                <VerticalStackLayout>
                    <Label x:Name="lblResultado" FontSize="20" FontAttributes="Bold"
       TextColor="Black" HorizontalOptions="Center"/>
                    <Label x:Name="lblValorIMC" FontSize="32" FontAttributes="Bold"
                           TextColor="Black" HorizontalOptions="Center"/>

         

                    <Label x:Name="lblRangosExplicacion" FontSize="12" TextColor="Black"
                           HorizontalOptions="Center" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>